# ===== قاعدة البيانات (PostgreSQL) — إلزامي =====
# محلياً (Mac/Homebrew): postgres://localhost:5432/jadara
# على سيرفر الجامعة: postgres://مستخدم:كلمة_مرور@عنوان_الخادم:5432/jadara
DATABASE_URL=postgres://localhost:5432/jadara
# 1 فقط إن كانت القاعدة تتطلب اتصال SSL
DATABASE_SSL=0

# ===== الخادم =====
NODE_ENV=development
PORT=3000
# 1 عند التشغيل خلف خادم ويب/بروكسي الجامعة (HTTPS)
TRUST_PROXY=0
# 1 دائماً في الإنتاج (HTTPS). 0 للتشغيل المحلي بدون HTTPS
COOKIE_SECURE=0
# النطاق الرسمي النهائي (يُستخدم في روابط المشاركة وخريطة الموقع). يُضبط عند النقل لسيرفر الجامعة
SITE_URL=http://localhost:3000

# ===== حساب المدير الأول =====
# كلمة المرور الأولية تُنشأ عند أول تشغيل فقط (تُخزَّن مشفّرة). إن تُركت فارغة تُولَّد عشوائياً وتُطبع في الطرفية.
ADMIN_INITIAL_PASSWORD=
# 0 = لا يُجبَر المدير على تغيير كلمة المرور عند أول دخول (للعرض المحلي فقط). في الإنتاج اتركه 1.
ADMIN_FORCE_CHANGE=1

# ===== الملفات المرفوعة =====
# مجلد حفظ الصور والملفات (يجب أن يكون دائماً ومشمولاً بالنسخ الاحتياطي على سيرفر الجامعة)
DATA_DIR=./data
# اختياري: خدمة تخزين خارجية بدل المجلد المحلي (غير مطلوبة عادةً)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ===== المحتوى والنسخ الاحتياطي =====
# 1 يحمّل محتوى العرض عند أول تشغيل (يُحذف بزر واحد من الإعدادات). 0 لإطلاق نظيف.
SEED_DEMO=1
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ===== عند التشغيل بـ docker compose فقط =====
POSTGRES_PASSWORD=
APP_PORT=3000
